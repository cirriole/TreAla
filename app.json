{
  "expo": {
    "name": "Alarm",
    "slug": "Alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alarm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio",
          "processing"
        ],
        "NSLocationWhenInUseUsageDescription": "駅への接近を監視するために位置情報を使用します。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "バックグラウンドで駅への接近を監視し、アラームを鳴らすために位置情報を使用します。",
        "NSLocationAlwaysUsageDescription": "バックグラウンドで駅への接近を監視し、アラームを鳴らすために位置情報を使用します。",
        "NSAlarmKitUsageDescription": "バックグラウンドで駅への接近を検知した際に、マナーモードを貫通するシステムアラームを鳴らすために使用します",
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "バックグラウンドで駅への接近を監視し、アラームを鳴らすために位置情報を使用します。",
          "locationWhenInUsePermission": "駅への接近を監視するために位置情報を使用します。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
