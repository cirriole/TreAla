{
  "expo": {
    "name": "Alarm",
    "slug": "Alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alarm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "appleTeamId": "A1B2C3D4E5",
      "bundleIdentifier": "com.ui.applab.alarm",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.ui.applab.alarm"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio",
          "processing",
          "location",
          "audio",
          "processing"
        ],
        "NSLocationWhenInUseUsageDescription": "駅への接近を監視するために位置情報を使用します。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "バックグラウンドで駅への接近を監視し、アラームを鳴らすために位置情報を使用します。",
        "NSLocationAlwaysUsageDescription": "バックグラウンドで駅への接近を監視し、アラームを鳴らすために位置情報を使用します。",
        "NSAlarmKitUsageDescription": "駅への接近を検知した際に、純正のアラーム画面でお知らせするために使用します。",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ui.applab.alarm",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "バックグラウンドで駅への接近を監視し、アラームを鳴らすために位置情報を使用します。",
          "locationWhenInUsePermission": "駅への接近を監視するために位置情報を使用します。"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c31e311-476b-43fd-82f3-08483587e8fa"
      }
    }
  }
}
